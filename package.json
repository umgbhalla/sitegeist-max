{
	"name": "sitegeist",
	"version": "0.1.0",
	"private": true,
	"description": "AI-powered browser extension for web navigation and interaction",
	"type": "module",
	"main": "dist/background.js",
	"scripts": {
		"clean": "rm -rf dist-chrome",
		"build:chrome": "node ./scripts/build.mjs",
		"build": "npm run build:chrome",
		"build:e2e": "SITEGEIST_E2E=1 node ./scripts/build.mjs",
		"test:e2e": "npm run build:e2e && playwright test",
		"dev": "concurrently -n \"build,server\" -c \"blue,yellow\" \"node ./scripts/build.mjs --watch\" \"node ./scripts/dev-server.mjs\"",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write . && tsc --noEmit && cd site && npm run check",
		"prepare": "husky",
		"postinstall": "patch-package"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.80.6",
		"@earendil-works/pi-ai": "^0.80.6",
		"@lmstudio/sdk": "^1.5.0",
		"@mariozechner/jailjs": "^0.1.0",
		"@mariozechner/mini-lit": "file:../mini-lit",
		"@sinclair/typebox": "^0.34.41",
		"chart.js": "^4.5.1",
		"docx-preview": "^0.3.7",
		"fuse.js": "^7.1.0",
		"highlight.js": "^11.11.1",
		"js-interpreter": "^6.0.1",
		"jszip": "^3.10.1",
		"lit": "^3.3.1",
		"lucide": "^0.544.0",
		"minimatch": "^10.0.3",
		"ollama": "^0.6.0",
		"pdfjs-dist": "5.4.394",
		"three": "^0.180.0",
		"tsx": "^4.20.6",
		"typebox": "^1.1.24",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/cli": "^4.0.0-beta.14",
		"@types/chrome": "^0.1.24",
		"@types/webextension-polyfill": "^0.12.4",
		"concurrently": "^9.2.1",
		"esbuild": "^0.25.10",
		"husky": "^9.1.7",
		"patch-package": "^8.0.1",
		"ws": "^8.18.0"
	}
}
